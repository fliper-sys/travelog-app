# Copy this file to .env.local (same folder as package.json) and fill it in.
# Restart `npm run dev` after changing it.
#
# Use ONLY the project URL and the public (publishable / anon) key.
# Never put the database password or a service_role / secret key here:
# NEXT_PUBLIC_ variables are visible in the browser.
NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key
