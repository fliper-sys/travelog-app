# Copy this file to .env (same folder as package.json), fill it in, then restart:
#   npx expo start -c
#
# Use ONLY the project URL and the public (publishable / anon) key, the same ones
# the web app uses. Never put the database password or a service_role / secret key
# here: EXPO_PUBLIC_ variables are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
